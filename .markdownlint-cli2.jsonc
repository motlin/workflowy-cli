// Configuration for markdownlint-cli2.
// Rule definitions live in .markdownlint.jsonc and are auto-merged.
// Docs: https://github.com/DavidAnson/markdownlint-cli2#configuration
{
	"globs": ["**/*.md"],
	"ignores": [
		"**/node_modules/**",
		".llm/**",
		".claude/**",
		"dist/**",
		"packages/*/dist/**",
		"backups/**",
		"AGENTS.md",
		// Contains the vp-generated Vite+ block, which markdownlint rules would flag
		"CLAUDE.md",
		"CLAUDE.local.md",
	],
}
