{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// packages/web/src/**/*.mdx mirrors the Storybook stories glob in packages/web/.storybook/main.ts;
	// fallow's storybook plugin only detects *.stories.* files, not docs pages.
	"entry": [
		"src/index.{ts,tsx,js,jsx}",
		"src/main.{ts,tsx,js,jsx}",
		"packages/cli/src/commands/**/*.ts",
		"packages/cli/src/commands/**/*.tsx",
		"packages/web/src/client/app.tsx",
		"packages/web/src/client/main.tsx",
		// Injected as a dev-only <script> by the stale-module-reload plugin in packages/web/vite.config.ts.
		"packages/web/src/client/dev-reload.ts",
		// Bundled by esbuild in the Worker tests rather than imported.
		"packages/cloudflare/test/probe-entry.ts",
		// Run by `just cf-smoke`, outside verify.
		"packages/cloudflare/smoke/run-smoke.ts",
		"bin/**/*.js",
		"plugins/gtd/scripts/**/*.mts",
		"test/evals/**/*.eval.ts",
		"test/evals/**/*.test.ts",
		"packages/web/src/**/*.mdx",
	],
	"workspaces": {
		"patterns": ["packages/*"],
	},
	"publicPackages": ["@workflowy/shared"],
	"ignorePatterns": [
		".storybook/**",
		"**/dist/**",
		"packages/*/dist/**",
		"packages/mcp/bin/**",
		"dist-test/**",
		"backups/**",
		"node_modules/**",
	],
	"duplicates": {
		// Hide pair-only clones; focus on widespread copy-paste
		// worth refactoring. Lower to 2 to report every duplicate pair.
		"minOccurrences": 3,
	},
	"rules": {
		"unused-dependencies": "error",
	},
	// Resolve @workflowy/shared imports to src/ (via the "source" export condition) instead of dist/,
	// so cross-package usages of shared class members are seen.
	"resolve": {
		"conditions": ["source"],
	},
	// eslint-plugin-storybook is loaded by name from the vite.config.ts lint jsPlugins, which fallow does not trace.
	"ignoreDependencies": [
		"@oclif/plugin-help",
		"@voidzero-dev/vite-plus-test",
		"better-sqlite3",
		"eslint-plugin-storybook",
	],
}
