{
	"name": "workflowy",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "../web/dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/health", "/api/*"],
	},
	"durable_objects": {
		"bindings": [{"name": "USER_STORE", "class_name": "UserStore"}],
	},
	"r2_buckets": [{"binding": "SNAPSHOTS", "bucket_name": "workflowy-snapshots"}],
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["UserStore"]}],
	// Placeholders: set real values as dashboard secrets/vars. Never set ACCESS_DEV_IDENTITY here; use .dev.vars.
	"vars": {"ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ALLOWED_EMAILS": "", "SYNC_INTERVAL_MINUTES": "30"},
}
