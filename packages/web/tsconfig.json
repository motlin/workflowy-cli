{
	"compilerOptions": {
		"target": "es2022",
		"module": "Node16",
		"moduleResolution": "node16",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"composite": true,
		"outDir": "dist",
		"rootDir": "src",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.stories.tsx", "src/**/*.stories.ts"],
	"references": [{"path": "../shared"}]
}
