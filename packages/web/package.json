{
	"name": "@workflowy/web",
	"version": "0.0.0",
	"description": "Web UI for Workflowy with React frontend and Hono API server",
	"type": "module",
	"main": "dist/server/index.js",
	"types": "dist/server/index.d.ts",
	"scripts": {
		"dev": "concurrently \"vp run dev:server\" \"vp run dev:client\"",
		"dev:server": "tsx watch src/server/index.ts",
		"dev:client": "vp dev",
		"build": "tsc && vp build",
		"typecheck": "tsc --noEmit",
		"storybook": "storybook dev --port 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.12",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.9",
		"@workflowy/shared": "workspace:*",
		"better-sqlite3": "^13.0.2",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.34",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hotkeys-hook": "^5.3.3",
		"react-router-dom": "^7.18.2",
		"sqlite-vec": "^0.1.9",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.5.5",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/react-vite": "^10.5.6",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"concurrently": "^10.0.4",
		"storybook": "^10.5.5",
		"tsx": "^4.23.5",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
