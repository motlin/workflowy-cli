{
	"name": "@workflowy/web",
	"version": "0.0.0",
	"description": "Web UI for Workflowy with React frontend and Hono API server",
	"type": "module",
	"main": "dist/server/index.js",
	"types": "dist/server/index.d.ts",
	"exports": {
		".": {
			"source": "./src/server/index.ts",
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./server-app": {
			"source": "./src/server/app.ts",
			"types": "./dist/server/app.d.ts",
			"import": "./dist/server/app.js"
		}
	},
	"scripts": {
		"dev": "concurrently \"vp run dev:server\" \"vp run dev:client\"",
		"dev:server": "tsx watch --conditions=source src/server/index.ts",
		"dev:client": "vp dev",
		"build": "tsc && vp build",
		"build:types": "tsc",
		"typecheck": "tsc --noEmit",
		"storybook": "storybook dev --port 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"@hono/node-ws": "^1.3.1",
		"@rehookify/datepicker": "^6.6.8",
		"@tanstack/react-query": "^5.104.4",
		"@workflowy/shared": "workspace:*",
		"better-sqlite3": "^13.0.3",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.13",
		"math-expression-evaluator": "^2.0.7",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.4",
		"sqlite-vec": "^0.1.9",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.65.0",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/react-vite": "^10.6.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"happy-dom": "^21.0.4",
		"storybook": "^10.6.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=20.11.0"
	}
}
