{
	"compilerOptions": {
		"target": "es2023",
		"module": "Node16",
		"moduleResolution": "node16",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["node"],
		"declaration": true,
		"composite": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*"]
}
