{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": [
		"src/index.{ts,tsx,js,jsx}",
		"src/main.{ts,tsx,js,jsx}",
		"packages/cli/src/commands/**/*.ts",
		"packages/cli/src/commands/**/*.tsx",
		"packages/web/src/client/app.tsx",
		"packages/web/src/client/main.tsx",
		"bin/**/*.js",
		"plugins/gtd/scripts/**/*.mjs",
		"test/evals/**/*.eval.ts",
		"test/evals/**/*.test.ts"
	],
	"workspaces": {
		"patterns": ["packages/*"]
	},
	"ignorePatterns": [
		".storybook/**",
		"**/dist/**",
		"packages/*/dist/**",
		"packages/mcp/bin/**",
		"dist-test/**",
		"backups/**",
		"node_modules/**"
	],
	"duplicates": {
		// Hide pair-only clones; focus on widespread copy-paste
		// worth refactoring. Lower to 2 to report every duplicate pair.
		"minOccurrences": 3
		// Common additions (uncomment to enable):
		// "ignore": [
		//   "**/lib/**",          // for repos that publish transpiled output to lib/
		//   "**/legacy/**",       // for repos with legacy-build artifacts
		//   "**/__generated__/**", // Relay, GraphQL Code Generator
		//   "**/generated/**"     // OpenAPI, Protobuf codegen
		// ]
	},
	"rules": {
		"unused-dependencies": "warn"
	},
	"ignoreDependencies": ["@oclif/plugin-help", "@workflowy/shared", "@voidzero-dev/vite-plus-test", "better-sqlite3"],
	"ignoreExports": [
		{
			"file": "packages/cli/src/commands/base-list-command.ts",
			"exports": ["*"]
		},
		{
			"file": "packages/cli/src/services/list-by-id.ts",
			"exports": ["*"]
		}
	]
}
